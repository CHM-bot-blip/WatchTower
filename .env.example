# =============================================================
# WatchTower — Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit the real .env to Git
# =============================================================

# ----------------------------
# 🔐 Authentication & Security
# ----------------------------
SECRET_KEY=your-super-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
FIRST_SUPERUSER=admin@watchtower.com
FIRST_SUPERUSER_PASSWORD=changeme

# ----------------------------
# 🗄️ Database (PostgreSQL)
# ----------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=watchtower
POSTGRES_USER=watchtower
POSTGRES_PASSWORD=changeme

# ----------------------------
# 📡 Prometheus
# ----------------------------
PROMETHEUS_URL=http://192.168.20.106:9090

# ----------------------------
# 🔥 pfSense
# ----------------------------
PFSENSE_SSH_HOST=192.168.1.1
PFSENSE_SSH_USER=root
PFSENSE_SSH_KEY=app/ssh/watchtower-ansible
PFSENSE_INSTANCE=192.168.1.1:9100
DHCP_LEASES_FILE=/var/dhcpd/var/db/dhcpd.leases

# ----------------------------
# 🕳️ Pi-hole
# ----------------------------
PIHOLE_URL=http://192.168.50.100
PIHOLE_PASSWORD=changeme

# ----------------------------
# 📦 Backend
# ----------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
VITE_API_URL=http://192.168.40.100:8000

# ----------------------------
# 🔔 Notifications (optional)
# ----------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# ----------------------------
# ☁️ Backup (Rclone / optional cloud)
# ----------------------------
RCLONE_REMOTE_NAME=gdrive
RCLONE_REMOTE_PATH=/WatchTower/backups
